# Copy to .env (or just export in your shell) and fill in.
# Without a key the backend returns a harmless placeholder mod so the extension
# pipeline can still be exercised end-to-end.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-haiku-4-5-20251001, the cheapest current model)
TAILOR_MODEL=claude-haiku-4-5-20251001
# Free Apify token (apify.com -> Settings -> Integrations) for live widgets that scrape data.
APIFY_TOKEN=
# Free Gemini key (aistudio.google.com) — vision layer for "Help with this screen".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Set to 1 for the live demo: scripted prompts return instant, pre-tested results.
DEMO_MODE=
